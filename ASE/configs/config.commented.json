// ServerPerformance - commented configuration.
//
// This file holds the same settings and values as config.json, with an explanation on each one.
// The plugin only reads config.json. Comments are allowed there too, so you can copy this file
// over config.json if you prefer to keep the notes.
//
// After editing config.json, run ServerPerformance.Reload (RCON, or the in-game console as an
// admin) to apply it without a restart. If the file has a mistake, the old settings stay active
// and the error is written to the API log.
{
  // Extra garbage collections requested by the plugin. Off by default: the engine collects on its
  // own schedule, and the GC settings under ConsoleVariables tune that schedule, which is the better
  // tool (see the notes there). A request is handed to the engine, which runs it at its next safe
  // point in the frame. ServerPerformance.ForceGC works whatever is set here.
  "GarbageCollection": {
    // true: request a collection every AutoGC_Interval_Minutes.
    "AutoGC_Enabled": false,

    // Minutes between requested collections, 1 to 1440. Counted from when the world loaded.
    "AutoGC_Interval_Minutes": 15,

    // true: ask for a full purge (everything unreachable destroyed in one frame). false: ask for an
    // incremental purge spread over the next frames. On ASA this makes no difference in practice:
    // ARK's dedicated server does a full purge on every collection, and also when more than
    // gc.UnreachableObjectsFullPurgeThreshold objects (25000) are waiting.
    "FullPurge": false
  },

  // Engine console variables to set, "name": value. Applied in name order when the server has a
  // world loaded, and again after ServerPerformance.Reload. After setting each one the plugin reads
  // it back from the engine and logs whether the engine accepted it, so a name that doesn't exist in
  // this game build, or a variable that can only be set from an ini at startup, shows up in the log
  // instead of silently doing nothing. ServerPerformance.CVars lists what the engine holds now.
  //
  // Values are numbers, true/false (sent as 1/0) or a single word. Names may only contain letters,
  // digits, '.' and '_'.
  //
  // Removing a variable from this list and reloading puts it back to the value it had before this
  // plugin first changed it. Unloading the plugin does the same for all of them.
  //
  // ASE's engine (Unreal Engine 4) has far fewer console variables than ASA's. The ASA collection
  // settings (gc.PrimalDedicatedServerOnly..., ...OnIdleServerMultiplier, gc.NumRetriesBeforeForcingGC,
  // gc.ActorClusteringEnabled) and the ASA optional ones (net.UseAdaptiveNetUpdateFrequency,
  // gc.LowMemory.*, the incremental-reachability set) are not in this game build; setting one only
  // logs "not a console variable in this game build".
  "ConsoleVariables": {
    // Seconds between garbage collections. On ASE this is not a console variable: the plugin reads
    // and writes the engine's own setting for it under this name. See what the server had before
    // with ServerPerformance.CVar gc.TimeBetweenPurgingPendingKillObjects. Fewer collections mean
    // fewer hitches but more memory held between them; the effect of 300 on ASE has not been
    // measured the way the ASA interval was, so watch memory in ServerPerformance.Stats after
    // changing it.
    "gc.TimeBetweenPurgingPendingKillObjects": 300,

    // Server frame-rate cap. 0 = no cap. The server's real tick rate is shown by
    // ServerPerformance.Stats, so you can see what a change actually does.
    "t.MaxFPS": 30
  },

  // Every this many seconds the plugin reads the variables above back from the engine and sets any
  // that something else has changed (the change is logged). 0 = only set them on load and reload.
  "ConsoleVariables_Reapply_Seconds": 300,

  // Lower how often structures send updates to players (replication frequency). Less network and
  // CPU on servers with many structures; a structure's changes can reach players later. Off by
  // default: test it on a test server first. Only ever lowers: a structure already at or below the
  // target is left alone. Turning it off and reloading, or unloading the plugin, puts every
  // structure back to its class default.
  "Structures": {
    "Enabled": false,

    // Updates per second for structures above this (0.2 = one every 5 seconds).
    "NetUpdateFrequency": 0.2,

    // Lowest rate the engine's adaptive replication may drop a structure to. Only has an effect
    // while net.UseAdaptiveNetUpdateFrequency is 1 (see ConsoleVariables). ASA only; ASE's engine
    // has no such setting and ignores it. Kept at or below NetUpdateFrequency.
    "MinNetUpdateFrequency": 0.1,

    // Seconds between passes, so newly placed structures are picked up too. 10 to 86400.
    "CheckInterval_Seconds": 300,

    // Structures whose class path contains any of these words (not case-sensitive) are left alone.
    // Defaults cover things players expect to react straight away.
    "ExcludeClassesContaining": [
      "Turret",
      "Door",
      "Gate",
      "Elevator",
      "Lift",
      "Teleporter",
      "Transmitter"
    ]
  },

  // Periodic stats, written to ServerPerformance_stats.log in this plugin's folder (one line each).
  // ServerPerformance.Stats shows the same numbers on demand.
  "Stats": {
    // Seconds between stats lines. 0 = none (the command still works). The tick-rate figures in each
    // line cover the time since the previous line.
    "LogInterval_Seconds": 300,

    // true: also write each stats line to the API log and console.
    "AlsoWriteToApiLog": false,

    // true: include dino and structure counts (a lookup of each, done only when stats are taken).
    "CountDinosAndStructures": true,

    // true: sample every player connection once a second and report total upload/download,
    // ping, packet loss, and how often connections were bandwidth-limited (had more to send than
    // their rate allowed). A high bandwidth-limited share points at the per-client rate limits
    // (MaxClientRate / MaxInternetClientRate in Engine.ini) rather than the CPU.
    "IncludeNetwork": true,

    // Hitch log: any second in which the server ran fewer than this many frames is written to the
    // stats log as "Hitch: N frames in X s", the moment it ends. A freeze shows as one line with its
    // length, so it can be matched against the server log (save, collection, a mod, a console window
    // left in text-selection mode). With t.MaxFPS 30, 25 catches garbage collections (~0.25 s) and
    // anything longer. 0 = off.
    "HitchThreshold_TicksPerSecond": 25,

    // The stats log starts a new file at this size and keeps this many old ones.
    "LogFileMaxSize_MB": 5,
    "LogFilesKept": 3
  }
}
